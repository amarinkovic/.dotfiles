{
  "layer": "top",
  "position": "top", // Waybar position (top|bottom|left|right)
  "height": 24, // Waybar height (to be removed for auto height)
  "spacing": 10, // Gaps between modules (4px)
  "reload_style_on_change": true,
  "include": [
    "~/.config/waybar/hardware.jsonc"
  ],
  "modules-left": [
    "custom/apps",
    "hyprland/workspaces"
  ],
  "modules-center": [
    "hyprland/window"
  ],
  "modules-right": [
    "idle_inhibitor",
    "custom/dnd",
    "privacy",
    "custom/spotify",
    "pulseaudio",
    "tray",
    "group/hardware",
    "network",
    "clock",
    "custom/power",
  ],
  "hyprland/window": {
    "format": "{title}",
    "max-length": 90,
    "separate-outputs": true,
  },
  // custom app
  "custom/apps": {
    "format": " 󰣇 ",
    "tooltip": false,
    "on-click": "wofi --show drun",
  },
  // Modules configuration
  "hyprland/workspaces": {
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"r-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"r+1\" })'",
    "on-click": "hyprctl dispatch 'hl.dsp.focus({{ workspace = \"{name}\" }})'",
    "disable-scroll": true,
    "all-outputs": true,
    "warp-on-scroll": false,
    "format": "{icon} {name}",
    "format-icons": {
      "urgent": " ",
      "active": " ",
      "default": " ",
    },
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": " ",
      "deactivated": " ",
    },
  },
  // Do-Not-Disturb toggle wired to dunst. signal 8 = SIGRTMIN+8, refreshed on click.
  "custom/dnd": {
    "exec": "dunstctl is-paused | grep -q true && echo '󰂛' || echo '󰂚'",
    "on-click": "dunstctl set-paused toggle && pkill -RTMIN+8 waybar",
    "signal": 8,
    "interval": "once",
    "tooltip": false,
  },
  // Shows an icon only while the mic, camera, or a screen-share is in use; auto-hides otherwise.
  "privacy": {
    "icon-size": 14,
    "icon-spacing": 8,
    "transition-duration": 200,
    "modules": [
      { "type": "screenshare" },
      { "type": "audio-in" },
    ],
  },
  "tray": {
    "icon-size": 20,
    "spacing": 10,
  },
  "clock": {
    // "timezone": "America/New_York",
    "format": " {:%H:%M}",
    "format-alt": "{:%Y-%m-%d}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "min-width": 80,
  },
  "network": {
    // "interface": "wlp2*", // (Optional) To force the use of this interface
    "format-wifi": "{icon} {essid} {signalStrength}%",
    "format-ethernet": " {ifname}",
    "tooltip-format": " {ifname} via {gwaddr}",
    "format-linked": " {ifname} (No IP)",
    "format-disconnected": "⚠ Disconnected",
    "format-alt": " {ifname}: {ipaddr}/{cidr}",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
  },
  "pulseaudio": {
    "scroll-step": 5, // %, can be a float
    "format": "{icon} {volume}%", // {format_source}
    "format-bluetooth": " {icon} {volume}% {format_source}",
    "format-bluetooth-muted": "  {icon} {format_source}",
    "format-muted": "  {format_source}",
    "format-icons": {
      "headphone": " ",
      "hands-free": " ",
      "headset": " ",
      "phone": " ",
      "portable": " ",
      "car": " ",
      "default": ["", " ", " "],
    },
    "on-click": "pavucontrol",
  },
  "custom/power": {
    "format": " 󰐥 ",
    "tooltip": false,
    "on-click": "wlogout --protocol layer-shell",
  },
  // https://lib.rs/crates/waybar_media_display
  "custom/spotify": {
    "format": "{}",
    "max-length": 256,
    "restart-interval": 5,
    "exec": "~/.config/waybar/player.sh",
    "exec-if": "playerctl -l | grep -q spotify",
    "on-click": "playerctl --player=spotify play-pause",
    "escape": true,
  },
}
